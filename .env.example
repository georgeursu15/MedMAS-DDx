# ---------------------------------------------------------------------------
# MedMAS-DDx — example configuration
#
# Copy this file to the one your deployment reads, then fill it in:
#
#   cp .env.example .env        # docker-compose.external-llm.yml
#   cp .env.example .env.dgx    # docker-compose.dgx.yml (self-hosted vLLM)
#
# Keep the copies out of version control. This file holds no secrets.
# ---------------------------------------------------------------------------


# --- Models ----------------------------------------------------------------
# Every agent resolves its model in this order:
#   its own override  ->  MEDMAS_DDX_LLM  ->  src/MedMAS_DDx/config/agents.yaml
# Values are LiteLLM identifiers, "<provider>/<model>".
#
# agents.yaml currently declares google/gemma-4-31b-it for all four agents, so
# anything set here takes precedence over that.

MEDMAS_DDX_LLM=google/gemini-3.1-flash-lite-preview

# Per-agent overrides. Leave empty to fall back to MEDMAS_DDX_LLM.
SYMPTOM_EXTRACTOR_LLM=
FOLLOWUP_INTERVIEWER_LLM=
DIAGNOSIS_REFINER_LLM=

# The simulated patient. Used by the evaluation harness only — it never takes
# part in a live diagnosis.
PATIENT_LLM=

# Read by the evaluation harness and passed through by the Compose files.
MODEL=google/gemini-3.1-flash-lite-preview

# Seconds before an LLM call is abandoned.
MEDMAS_DDX_LLM_TIMEOUT=300


# --- Provider credentials --------------------------------------------------
# Read by LiteLLM. Set only the one matching the models chosen above; leave the
# rest empty rather than deleting them, so it stays obvious what is supported.

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Also the key the self-hosted deployment below uses. vLLM does not check it,
# but the client refuses to send an empty one, so set it to EMPTY there.
OPENAI_API_KEY=


# --- Self-hosted model, docker-compose.dgx.yml only ------------------------
# vLLM serves the model behind an OpenAI-compatible API, so pointing the
# OpenAI base URL at the container is the whole integration.
#
# Uncomment both for that deployment, and set OPENAI_API_KEY above to EMPTY.
#
# MedGemma is gated on Hugging Face: accept its licence on the model page
# before the first run, or the download fails with a 401.

#OPENAI_API_BASE=http://vllm:8000/v1
#HUGGING_FACE_HUB_TOKEN=


# --- Knowledge base --------------------------------------------------------
# Both Compose files set these to the graphdb service, overriding whatever is
# here. They matter only when running outside Docker, and the values below are
# already the built-in defaults — uncomment only to point somewhere else.

#GRAPHDB_REPOSITORY_URL=http://localhost:7200/repositories/DoidOntologyRepository
#HP_GRAPHDB_REPOSITORY_URL=http://localhost:7200/repositories/HpOntologyRepository


# --- Scoring ---------------------------------------------------------------
# Weights of the bounded multiplicative update in Phase 2 (Eq. 6 in the paper).
# alpha rewards confirmations, beta penalises denials. The values below are the
# built-in defaults and the ones the published results use; only
# docker-compose.dgx.yml restates them explicitly.

#REFINE_SUPPORT_WEIGHT=0.6
#REFINE_CONFLICT_WEIGHT=0.2
